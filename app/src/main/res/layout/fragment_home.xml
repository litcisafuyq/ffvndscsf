<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Hero Card: Status & Primary Launch Action -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_tactical"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/view_home_status_dot"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="@drawable/bg_bubble_red" />

                <TextView
                    android:id="@+id/tv_home_injector_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/status_no_permission"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_home_game_installed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/jetbrains_mono"
                android:text="Gói mục tiêu: com.garena.ffvn / com.dts.freefireth"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Primary CTA: Vào Free Fire -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_launch_free_fire"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/accent_emerald"
                android:text="@string/btn_launch_ff"
                android:textColor="@color/bg_obsidian"
                android:textSize="17sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_play_game"
                app:iconGravity="textStart"
                app:iconTint="@color/bg_obsidian" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_toggle_overlay"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/btn_start_overlay"
                    android:textColor="@color/accent_cyan"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/accent_cyan" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_home_emergency_kill"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/btn_emergency_kill"
                    android:textColor="@color/status_red"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/status_red" />
            </LinearLayout>
        </LinearLayout>

        <!-- Master Control & Engine Telemetry Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_tactical"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/sw_home_master"
                style="@style/A17.Switch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Công tắc tổng (Master Engine)"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="@color/divider_subtle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="THÔNG SỐ QUY ĐỔI MÀN HÌNH &amp; ENGINE"
                android:textColor="@color/accent_cyan"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_home_device_scale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/jetbrains_mono"
                android:text="deviceScale = --"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_home_engine_telemetry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/jetbrains_mono"
                android:text="Engine: SLEEP | 0 evt/s | Thermal: 1.00x"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Weapon Timing Reset & Fire Gate Test Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_tactical"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BỘ HỌC NHỊP SÚNG &amp; KIỂM TRA CỬ CHỈ"
                android:textColor="@color/accent_emerald"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="TimingLearner (8 phát, rate 0.25, trần 50ms) tự reset khi đổi nhóm súng. Bạn có thể giữ nút dưới để thử phản hồi rung &amp; đường cong ngay."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_weapon_reset"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Đổi súng (Reset)"
                    android:textColor="@color/text_primary"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_test_fire_gate"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Giữ thử nút bắn"
                    android:textColor="@color/accent_emerald"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/accent_emerald" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
